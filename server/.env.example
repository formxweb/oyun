# VERTIGO backend configuration. Copy to server/.env (never commit the real file).
# Everything secret lives here, on the server — nothing below is ever built into a client.

PORT=8787
# where the state snapshot is kept (default: server/data)
DATA_DIR=/var/lib/vertigo
# the web/Electron/Capacitor origins allowed to call the API ('*' is fine: auth is bearer tokens)
CORS_ORIGIN=*
TOKEN_DAYS=90

# Steam (Steamworks partner site -> Users & Permissions -> Manage Groups -> Web API key)
STEAM_APP_ID=
STEAM_WEB_API_KEY=
# 1 = ISteamMicroTxnSandbox (test purchases, no money moves)
STEAM_SANDBOX=1
# must match the identity the game passes to GetAuthTicketForWebApi
STEAM_AUTH_IDENTITY=vertigo

# Google Play (Play Console -> API access -> service account with "View financial data" and
# "Manage orders"); the value is the JSON key file path or its contents
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT=
# Play Games Services v2 server-side access (Google Cloud OAuth "Web application" client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
